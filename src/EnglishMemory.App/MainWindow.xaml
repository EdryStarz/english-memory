<Window x:Class="EnglishMemory.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:EnglishMemory.App.UI" Title="English Memory">
    <Grid x:Name="Root" Background="{ThemeResource SurfaceBrush}">
        <Grid.Resources><ui:LocalizedLabelConverter x:Key="LocalizedLabel"/><DataTemplate x:Key="LocalizedChoice"><TextBlock Text="{Binding Converter={StaticResource LocalizedLabel}}"/></DataTemplate><ui:BooleanVisibilityConverter x:Key="BoolVisibility"/><DataTemplate x:Key="PhraseTemplate"><Grid Padding="{StaticResource RowPadding}"><StackPanel Spacing="4"><TextBlock Text="{Binding Target}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Translation}" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="{Binding Quote}" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MediaLabel}" Visibility="{Binding HasMedia,Converter={StaticResource BoolVisibility}}" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Metadata}" Style="{StaticResource MutedText}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="I know this" Click="KnowRowClick"/><Button Content="Not needed" Click="HideRowClick"/></StackPanel></StackPanel></Grid></DataTemplate></Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="{ThemeResource RuleBrush}" BorderThickness="0,0,0,1" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"><TextBlock x:Name="BrandText" Text="English Memory" FontWeight="SemiBold"/><TextBlock x:Name="ListeningStatusText" Text="{Binding Status}" MaxWidth="340" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AccentBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Listen / Pause" Command="{Binding ToggleListeningCommand}" ToolTipService.ToolTip="Ctrl+Shift+L"/><Button Content="Private mode" Command="{Binding TogglePrivateCommand}" ToolTipService.ToolTip="Ctrl+Shift+P"/></StackPanel></Grid></Border>
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Top" IsPaneOpen="True" OpenPaneLength="204" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="NavigationChanged" AlwaysShowHeader="False">
            <NavigationView.MenuItems><NavigationViewItem Content="Mix" Tag="Mix" Icon="Play"/><NavigationViewItem Content="Dictionary" Tag="Library" Icon="Library"/><NavigationViewItem Content="Add text" Tag="Today" Icon="Add"/></NavigationView.MenuItems>
            <NavigationView.FooterMenuItems><NavigationViewItem Content="Tools" Tag="Tools" Icon="More"><NavigationViewItem.MenuItems><NavigationViewItem Content="Video source" Tag="Media" Icon="Video"/><NavigationViewItem Content="AI Models" Tag="Models" Icon="Download"/><NavigationViewItem Content="Live transcript" Tag="Live" Icon="Microphone"/><NavigationViewItem Content="Progress" Tag="Progress" Icon="OutlineStar"/></NavigationViewItem.MenuItems></NavigationViewItem></NavigationView.FooterMenuItems>
            <Grid x:Name="ContentGrid" Padding="{StaticResource PagePadding}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel x:Name="PageHeadingStrip" Spacing="8" Margin="0,0,0,16"><TextBlock x:Name="PageTitle" Text="Today" Style="{StaticResource TitleText}"/><InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" Severity="Informational" Message="{Binding Notice}"/></StackPanel>
                <ScrollViewer x:Name="TodayPanel" Grid.Row="1" Visibility="Collapsed"><StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="A phrase you said, heard or want to remember." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/><TextBox x:Name="QuickAddBox" Text="{Binding QuickText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="120" MaxHeight="240" TextWrapping="Wrap" PlaceholderText="Paste English or Russian text…" AutomationProperties.Name="Text for local analysis"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Add to mix" Style="{StaticResource PrimaryButton}" Command="{Binding AddTextCommand}"/><Button Content="From clipboard" Click="ClipboardClick"/><Button Content="Import file…" Click="ImportClick"/></StackPanel><TextBlock Text="New phrases appear in the mix automatically." TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/><TextBlock x:Name="CaptureSourceText" Style="{StaticResource MutedText}"/><StackPanel Visibility="Collapsed"><ListView ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource PhraseTemplate}"/><TextBlock x:Name="EmptyRecent"/></StackPanel></StackPanel></ScrollViewer>
                <Grid x:Name="MixPanel" Grid.Row="1" MaxWidth="900" HorizontalAlignment="Stretch" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MixSummary}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}"/><Button Grid.Column="1" Content="{Binding MixSettingsLabel}"><Button.Flyout><Flyout><StackPanel Spacing="12" MinWidth="260"><ComboBox x:Name="MixLevelChoice" Header="Words from audio" SelectionChanged="MixSettingsChanged" ItemTemplate="{StaticResource LocalizedChoice}"><x:String>A1+</x:String><x:String>A2+</x:String><x:String>B1+</x:String><x:String>B2+</x:String><x:String>C1+</x:String></ComboBox><ComboBox x:Name="MixRatioChoice" Header="New cards" SelectionChanged="MixSettingsChanged"><x:String>60%</x:String><x:String>75%</x:String><x:String>90%</x:String></ComboBox><Button Content="Hide basic / invalid words" Click="HideBasicClick"/></StackPanel></Flyout></Button.Flyout></Button></Grid>
                    <ScrollViewer x:Name="MixCardScroll" Grid.Row="1">
                    <Border Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource RuleBrush}" BorderThickness="1" CornerRadius="16" Padding="24"><StackPanel Spacing="16">
                        <Grid x:Name="MixCardTop"><Grid.ColumnDefinitions><ColumnDefinition x:Name="MixPictureColumn" Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel x:Name="MixPicturePane" Spacing="6" Margin="0,0,24,0"><Border Background="#EEE7DA" CornerRadius="12"><Grid x:Name="MixPictureFrame" Width="256" Height="160"><Canvas x:Name="MixPictureCanvas" Width="256" Height="160" HorizontalAlignment="Left" VerticalAlignment="Top"><Canvas.RenderTransform><ScaleTransform x:Name="MixPictureScale"/></Canvas.RenderTransform><Canvas.Clip><RectangleGeometry Rect="0,0,256,160"/></Canvas.Clip><Image x:Name="MixAtlasImage" Width="1024" Height="640" Stretch="Fill"><Image.RenderTransform><TranslateTransform x:Name="MixPictureShift"/></Image.RenderTransform></Image></Canvas><Image x:Name="CustomCardPicture" Width="256" Height="160" Stretch="UniformToFill" Visibility="Collapsed"/></Grid></Border><TextBlock x:Name="MixPictureLabel" MaxWidth="256" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel x:Name="MixWordPane" Grid.Column="1" Spacing="12" VerticalAlignment="Center"><TextBlock Text="{Binding ReviewPosition}" Foreground="{ThemeResource AccentBrush}" TextWrapping="Wrap"/><TextBlock x:Name="MixPromptText" Text="{Binding ReviewPrompt}" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/><Button Content="Pronounce" Click="SpeakReviewClick" Visibility="{Binding HasReviewCard,Converter={StaticResource BoolVisibility}}"/></StackPanel>
                        </Grid>
                        <StackPanel x:Name="MixAnswerPane" Spacing="12" Visibility="{Binding AnswerShown,Converter={StaticResource BoolVisibility}}"><Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="{Binding ReviewAnswer}" FontSize="26" TextWrapping="Wrap"/><TextBlock Text="{Binding ReviewQuote}" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
                        <StackPanel Spacing="12" Visibility="{Binding MixEmpty,Converter={StaticResource BoolVisibility}}"><TextBlock Text="New words arrive automatically. Add a phrase, import subtitles or start listening. Scheduled reviews will also return here." TextWrapping="Wrap"/><Button Content="Add text" Click="OpenAddClick"/></StackPanel>
                    </StackPanel></Border>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button x:Name="MixRevealButton" Content="Show translation · Space" MinHeight="44" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Command="{Binding ShowAnswerCommand}"/>
                        <Grid ColumnSpacing="8" Visibility="{Binding AnswerShown,Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="MixAgainButton" Content="1 · Again" Tag="Again" Click="RateClick" MinHeight="44" HorizontalAlignment="Stretch"/><Button x:Name="MixRememberButton" Grid.Column="1" Content="3 · Remembered" Tag="Good" Click="RateClick" MinHeight="44" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}"/></Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="I know this" Command="{Binding KnowMixCommand}" IsEnabled="{Binding HasReviewCard}" ToolTipService.ToolTip="K"/><Button Content="Not needed" Command="{Binding IgnoreMixCommand}" IsEnabled="{Binding HasReviewCard}" ToolTipService.ToolTip="Delete"/><Button Content="Undo" Command="{Binding UndoActionCommand}" IsEnabled="{Binding CanUndo}"/><Button Content="More"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Picture…" Click="ChooseCardPictureClick"/><MenuFlyoutItem Text="Hide basic / invalid words" Click="HideBasicClick"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="2 · Hard" Tag="Hard" Click="RateMenuClick"/><MenuFlyoutItem Text="4 · Easy" Tag="Easy" Click="RateMenuClick"/></MenuFlyout></Button.Flyout></Button></StackPanel>
                        <TextBlock Text="{Binding Notice}" ToolTipService.ToolTip="{Binding Notice}" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{ThemeResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="BrowsePanel" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16"><TextBox x:Name="SearchBox" Width="250" PlaceholderText="Search phrases and real quotes" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search library"/><ComboBox x:Name="LibraryStateChoice" Width="165" ItemTemplate="{StaticResource LocalizedChoice}" SelectedIndex="0" SelectionChanged="LibraryStateChanged"><x:String>To learn</x:String><x:String>All words</x:String><x:String>Known words</x:String><x:String>Hidden words</x:String></ComboBox><ComboBox x:Name="TopicFilter" ItemTemplate="{StaticResource LocalizedChoice}" Width="170" SelectedIndex="0" SelectionChanged="FilterChanged"><x:String>All topics</x:String><x:String>Conversation</x:String><x:String>Work</x:String><x:String>Development</x:String><x:String>Streaming</x:String><x:String>Games</x:String><x:String>Movies</x:String><x:String>Travel</x:String><x:String>Home</x:String><x:String>Food</x:String></ComboBox></StackPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="3*"/><ColumnDefinition x:Name="DetailColumn" Width="2*"/></Grid.ColumnDefinitions><ListView x:Name="PhraseList" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PhraseTemplate}" SelectionMode="Multiple" SelectionChanged="PhraseSelectionChanged"/><Border x:Name="DetailsPane" Grid.Column="1" Margin="24,0,0,0" BorderBrush="{ThemeResource RuleBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0"><ScrollViewer><TextBlock Text="{Binding Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></Border><TextBlock x:Name="EmptyBrowse" Text="No phrases here yet. Add text from Today or start Listening." Margin="12" IsHitTestVisible="False"/></Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0"><TextBlock x:Name="SelectionCountText" VerticalAlignment="Center"/><Button Content="Learn selected" Click="LearnSelectedClick"/><Button Content="Know selected" Click="KnowSelectedClick"/><Button Content="Hide selected" Click="HideSelectedClick"/><Button Content="Undo" Command="{Binding UndoActionCommand}" IsEnabled="{Binding CanUndo}"/><Button Visibility="Collapsed" Content="Learn" Command="{Binding LearnCommand}"/><Button Visibility="Collapsed" Content="Important" Command="{Binding ImportantCommand}"/><Button Visibility="Collapsed" Content="Ignore" Command="{Binding IgnoreCommand}"/><Button Visibility="Collapsed" Content="I know this" Command="{Binding MarkKnownCommand}"/><Button Content="More"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Pronounce" Click="SpeakSelectedClick"/><MenuFlyoutItem Text="Show encounters" Click="DetailsClick"/><MenuFlyoutItem Text="Queue &amp; needs review" Click="NeedsReviewClick"/><MenuFlyoutItem Text="Load 500 more" Click="LoadMoreClick"/></MenuFlyout></Button.Flyout></Button></StackPanel>
                </Grid>
                <ScrollViewer x:Name="ReviewPanel" Grid.Row="1" Visibility="Collapsed"><StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="12"><TextBlock Text="{Binding ReviewPosition}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ReviewPrompt}" FontSize="{StaticResource DisplaySize}" FontWeight="SemiBold"/><Button Content="Pronounce" Click="SpeakReviewClick"/><TextBlock x:Name="AnswerHint" Text="Say the meaning aloud, then reveal the answer." Foreground="{ThemeResource MutedBrush}"/><Button x:Name="ShowAnswerButton" Content="Show answer · Space" Command="{Binding ShowAnswerCommand}" Style="{StaticResource PrimaryButton}"/><StackPanel Spacing="12" Visibility="{Binding AnswerShown,Converter={StaticResource BoolVisibility}}"><Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="{Binding ReviewAnswer}" FontSize="24"/><TextBlock Text="REAL CONTEXT" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ReviewQuote}" FontSize="20"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="1 · Again" Tag="Again" Click="RateClick"/><Button Content="2 · Hard" Tag="Hard" Click="RateClick"/><Button Content="3 · Good" Tag="Good" Click="RateClick" Style="{StaticResource PrimaryButton}"/><Button Content="4 · Easy" Tag="Easy" Click="RateClick"/></StackPanel></StackPanel></StackPanel></ScrollViewer>
                <ScrollViewer x:Name="ProgressPanel" Grid.Row="1" Visibility="Collapsed"><TextBlock Text="{Binding Progress}" FontSize="20" LineHeight="34" MaxWidth="740" HorizontalAlignment="Left"/></ScrollViewer>
                <Grid x:Name="LivePanel" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Live transcript · separate sources · raw audio is not saved" Foreground="{ThemeResource MutedBrush}" Margin="0,0,0,16"/><ListView Grid.Row="1" ItemsSource="{Binding Live}"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="8,12" IsTextSelectionEnabled="True"/></DataTemplate></ListView.ItemTemplate></ListView></Grid>
                <ScrollViewer x:Name="MediaPanel" Grid.Row="1" Visibility="Collapsed"><StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
<TextBlock x:Name="MediaIntroText" Text="Attach a film, series or episode to new encounters. This applies to PC Audio, imported subtitles and quotes added here." TextWrapping="Wrap"/>
<ToggleSwitch x:Name="MediaEnabledToggle" Header="Save video source context" Toggled="MediaToggled"/><ToggleSwitch x:Name="MediaAutoToggle" Header="Read player or browser window caption" Toggled="MediaToggled"/>
<TextBlock x:Name="MediaPreview" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
<Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="Player or browser window" Style="{StaticResource HeadingText}"/>
<ComboBox x:Name="MediaWindowChoice" Header="Open windows" MinWidth="300" MaxWidth="800"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh windows" Click="RefreshMediaWindowsClick"/><Button Content="Use selected window" Click="PinMediaWindowClick"/><Button Content="Use foreground window" Click="UnpinMediaWindowClick"/></StackPanel>
<TextBlock Text="A window caption is a suggestion. All PC audio may contain other apps; it does not prove the film is the audio source. A browser caption follows the active tab of the selected window." Style="{StaticResource MutedText}"/>
<Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="Manual source · takes priority" Style="{StaticResource HeadingText}"/>
<Button Content="Choose video filename" Click="ChooseVideoFilenameClick"/><TextBox x:Name="MediaTitleBox" Header="Film / series title" MaxLength="240" PlaceholderText="Leave empty to use window or subtitle filename"/>
<ComboBox x:Name="MediaKindChoice" Header="Content type" ItemTemplate="{StaticResource LocalizedChoice}"><x:String>Video / unknown</x:String><x:String>Movie</x:String><x:String>Series</x:String><x:String>Animated series</x:String></ComboBox>
<StackPanel Orientation="Horizontal" Spacing="16"><NumberBox x:Name="MediaSeasonBox" Header="Season (optional)" Minimum="0" Maximum="999" Width="180"/><NumberBox x:Name="MediaEpisodeBox" Header="Episode (optional)" Minimum="1" Maximum="999" Width="180"/></StackPanel><TextBox x:Name="MediaEpisodeTitleBox" Header="Episode title (optional)" MaxLength="240"/>
<StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save source" Click="ApplyMediaClick"/><Button Content="Clear manual title" Click="ClearManualMediaClick"/></StackPanel>
<Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="Subtitles for this source" Style="{StaticResource HeadingText}"/><TextBlock x:Name="MediaSubtitleStatus" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Choose SRT / VTT" Click="ChooseMediaSubtitlesClick"/><Button Content="Detach subtitles" Click="ClearMediaSubtitlesClick"/></StackPanel>
<TextBlock Text="Use subtitles in the spoken language. Unique matching lines can add a subtitle timestamp. Short or repeated lines keep their time unknown. S01E02 and 1x02 in filenames can supply season and episode; no internet lookup is performed." Style="{StaticResource MutedText}"/>
<TextBox x:Name="MediaQuoteBox" Header="Add a quote from this source" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Analyze quote with source" Click="AddMediaQuoteClick"/><Button Content="Use PC Audio" Click="UsePcAudioClick"/></StackPanel>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="ModelsPanel" Grid.Row="1" Visibility="Collapsed"><StackPanel x:Name="ModelRows" Spacing="16" MaxWidth="800" HorizontalAlignment="Left"/></ScrollViewer>
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed"><StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
                    <ComboBox x:Name="LanguageChoice" Header="Interface language" SelectionChanged="LanguageChanged"><x:String>Русский</x:String><x:String>English</x:String></ComboBox><TextBlock Text="Appearance" Style="{StaticResource HeadingText}"/><ComboBox x:Name="ThemeChoice" ItemTemplate="{StaticResource LocalizedChoice}" Header="Theme" SelectionChanged="ThemeChanged"><x:String>System</x:String><x:String>Light</x:String><x:String>Dark</x:String></ComboBox>
                    <Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="Listening &amp; privacy" Style="{StaticResource HeadingText}"/><ComboBox x:Name="SourceChoice" ItemTemplate="{StaticResource LocalizedChoice}" Header="Audio source" SelectionChanged="SourceChanged"><x:String>Microphone</x:String><x:String>PC Audio</x:String><x:String>Both</x:String></ComboBox><ComboBox x:Name="MicrophoneChoice" Header="Microphone device" MinWidth="320" SelectionChanged="MicrophoneChanged"/>
                    <ToggleSwitch x:Name="AutoCaptureToggle" Header="Automatically extract speech" Toggled="SettingToggled"/><ToggleSwitch x:Name="TrayToggle" Header="Close window to system tray" Toggled="SettingToggled"/><ToggleSwitch x:Name="StartupToggle" Header="Start with Windows · listening stays off" Toggled="StartupToggled"/>
                    <TextBlock Text="Raw audio is never written to disk. Private Mode stops both sources and clears audio buffers. System audio currently captures the entire output device; process selection and music classification are not available in this build." Foreground="{ThemeResource MutedBrush}"/>
                    <Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="Learning" Style="{StaticResource HeadingText}"/><ToggleSwitch x:Name="BasicFilterToggle" Header="Skip basic words even if AI labels them B1" Toggled="MixOptionToggled"/><ToggleSwitch x:Name="PicturesToggle" Header="Pictures on cards" Toggled="MixOptionToggled"/><NumberBox x:Name="RetentionBox" Header="Target retention (0.70–0.97)" Minimum="0.7" Maximum="0.97" SmallChange="0.01" ValueChanged="NumberChanged"/><NumberBox x:Name="ReviewLimitBox" Header="Maximum reviews per session" Minimum="1" Maximum="500" ValueChanged="NumberChanged"/>
                    <ComboBox x:Name="VoiceChoice" Header="Installed English voice" MinWidth="320" SelectionChanged="VoiceChanged"/><Slider x:Name="VoiceRate" Header="Speech speed" Minimum="-5" Maximum="5" StepFrequency="1" ValueChanged="VoiceRateChanged"/>
                    <Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="Local AI performance" Style="{StaticResource HeadingText}"/><TextBlock x:Name="HardwareText" Foreground="{ThemeResource MutedBrush}"/><ComboBox x:Name="PerformanceChoice" ItemTemplate="{StaticResource LocalizedChoice}" Header="Processing mode" SelectionChanged="PerformanceChanged"><x:String>Eco</x:String><x:String>Balanced</x:String><x:String>Fast</x:String></ComboBox><NumberBox x:Name="ThreadBox" Header="Maximum CPU threads" Minimum="1" Maximum="64" ValueChanged="NumberChanged"/><ToggleSwitch x:Name="GamingToggle" Header="Gaming mode · pause heavy language processing" Toggled="SettingToggled"/><ToggleSwitch x:Name="IdleToggle" Header="Process language only when PC is idle" Toggled="SettingToggled"/><TextBlock Text="CPU backend. GPU acceleration is not enabled in this build. Gaming mode is controlled manually; speech recognition continues." Style="{StaticResource MutedText}"/>
                    <Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="Global shortcuts" Style="{StaticResource HeadingText}"/><TextBox x:Name="ListenKeyBox" Header="Toggle Listening"/><TextBox x:Name="PrivateKeyBox" Header="Toggle Private Mode"/><TextBox x:Name="CaptureKeyBox" Header="Capture last moment"/><Button Content="Apply shortcuts" Click="ApplyHotkeysClick"/>
                    <Border Height="1" Background="{ThemeResource RuleBrush}"/><TextBlock Text="Your data" Style="{StaticResource HeadingText}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open data folder" Click="DataFolderClick"/><Button Content="Export JSON" Click="ExportClick"/><Button Content="Backup ZIP" Click="BackupClick"/></StackPanel><Button Content="Delete all learning data…" Click="DeleteDataClick"/><Button Content="Open source licenses" Click="LicensesClick"/><TextBlock Text="Your data lives in LocalAppData\EnglishMemory. Models are separate from your vocabulary backup." Style="{StaticResource MutedText}"/>
                </StackPanel></ScrollViewer>
            </Grid>
        </NavigationView>
        <Border Grid.Row="2" BorderBrush="{ThemeResource RuleBrush}" BorderThickness="0,1,0,0" Padding="16,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="QueueStatus" Style="{StaticResource MutedText}"/><TextBlock x:Name="OfflineLabel" Grid.Column="1" Text="LOCAL · OFFLINE READY AFTER MODEL SETUP" Style="{StaticResource MutedText}"/></Grid></Border>
    </Grid>
</Window>
