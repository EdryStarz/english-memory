<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="SurfaceBrush" Color="#FAFAF8"/><SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="MutedBrush" Color="#5C615D"/><SolidColorBrush x:Key="AccentBrush" Color="#237354"/><SolidColorBrush x:Key="RuleBrush" Color="#DFE3DF"/></ResourceDictionary>
        <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="SurfaceBrush" Color="#202321"/><SolidColorBrush x:Key="PanelBrush" Color="#282C29"/><SolidColorBrush x:Key="MutedBrush" Color="#ACB6AE"/><SolidColorBrush x:Key="AccentBrush" Color="#8DCEAB"/><SolidColorBrush x:Key="RuleBrush" Color="#3D453F"/></ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Color x:Key="SystemAccentColor">#237354</Color><Color x:Key="SystemAccentColorLight1">#368A67</Color><Color x:Key="SystemAccentColorLight2">#8DCEAB</Color><Color x:Key="SystemAccentColorLight3">#B9E0C9</Color><Color x:Key="SystemAccentColorDark1">#1D6548</Color><Color x:Key="SystemAccentColorDark2">#17533B</Color><Color x:Key="SystemAccentColorDark3">#11422E</Color><FontFamily x:Key="InterfaceFont">Segoe UI Variable</FontFamily>
    <x:Double x:Key="DisplaySize">36</x:Double><x:Double x:Key="TitleSize">28</x:Double><x:Double x:Key="HeadingSize">20</x:Double><x:Double x:Key="BodySize">15</x:Double><x:Double x:Key="LabelSize">14</x:Double><x:Double x:Key="CaptionSize">12</x:Double><x:Double x:Key="MetricSize">32</x:Double>
    <x:Double x:Key="SpaceSmall">8</x:Double><x:Double x:Key="SpaceMedium">16</x:Double><x:Double x:Key="SpaceLarge">24</x:Double><Thickness x:Key="PagePadding">32,24,32,24</Thickness><Thickness x:Key="RowPadding">12,12,12,12</Thickness><CornerRadius x:Key="ControlRadius">6</CornerRadius><CornerRadius x:Key="SurfaceRadius">8</CornerRadius><x:Double x:Key="ElevationFlat">0</x:Double><Duration x:Key="MotionQuick">0:0:0.15</Duration>
    <Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource TitleSize}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="HeadingText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource HeadingSize}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/><Setter Property="FontSize" Value="{StaticResource CaptionSize}"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="MinWidth" Value="140"/></Style>
</ResourceDictionary>
